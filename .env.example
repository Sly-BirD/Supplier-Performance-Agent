# =============================================================================
# Supplier Performance Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# ─── LLM Provider ───
GOOGLE_API_KEY=your-google-api-key

# ─── Database (Neon PostgreSQL) ───
# Sign up at https://neon.tech and create a project.
# Go to: Neon Console → Project → Connection Details → copy the connection string
# Replace the prefix: postgres:// → postgresql+asyncpg://
# Example: postgresql+asyncpg://user:pass@ep-cool-name-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Clerk Authentication ───
# Sign up at https://clerk.com and create an application.
# Go to: Clerk Dashboard → API Keys
# The Publishable Key goes in frontend/.env.local (see below)
CLERK_SECRET_KEY=sk_test_xxxxx
# The Issuer is your Frontend API URL, found in Clerk Dashboard → API Keys
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# ─── Resend Email Alerts ───
# Sign up at https://resend.com and create an API key.
# Go to: Resend Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxx
ALERT_FROM_EMAIL=onboarding@resend.dev
ALERT_RECIPIENT_EMAIL=your-email@example.com

# ─── Application ───
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000
